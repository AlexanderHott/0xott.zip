---
// Adapted from Astro Starlight's MIT-licensed Aside component:
// https://github.com/withastro/starlight/blob/main/packages/starlight/user-components/Aside.astro
import { AstroError } from "astro/errors";

const asideVariants = ["note", "tip", "caution", "danger"] as const;
type AsideVariant = (typeof asideVariants)[number];

interface Props {
  type?: AsideVariant;
  title?: string;
}

const defaultTitles: Record<AsideVariant, string> = {
  note: "Note",
  tip: "Tip",
  caution: "Caution",
  danger: "Danger",
};

const icons: Record<AsideVariant, string> = {
  note: '<path d="M12 11a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0-1-1Zm.38-3.92a1 1 0 0 0-.76 0 1 1 0 0 0-.33.21 1.15 1.15 0 0 0-.21.33 1 1 0 0 0 .21 1.09c.097.088.209.16.33.21A1 1 0 0 0 13 8a1.05 1.05 0 0 0-.29-.71 1 1 0 0 0-.33-.21ZM12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 18a8 8 0 1 1 0-16.001A8 8 0 0 1 12 20Z"/>',
  tip: '<path fill-rule="evenodd" d="M1.44 8.855v-.001l3.527-3.516c.34-.344.802-.541 1.285-.548h6.649l.947-.947c3.07-3.07 6.207-3.072 7.62-2.868a1.821 1.821 0 0 1 1.557 1.557c.204 1.413.203 4.55-2.868 7.62l-.946.946v6.649a1.845 1.845 0 0 1-.549 1.286l-3.516 3.528a1.844 1.844 0 0 1-3.11-.944l-.858-4.275-4.52-4.52-2.31-.463-1.964-.394A1.847 1.847 0 0 1 .98 10.693a1.843 1.843 0 0 1 .46-1.838Zm5.379 2.017-3.873-.776L6.32 6.733h4.638l-4.14 4.14Zm8.403-5.655c2.459-2.46 4.856-2.463 5.89-2.33.134 1.035.13 3.432-2.329 5.891l-6.71 6.71-3.561-3.56 6.71-6.711Zm-1.318 15.837-.776-3.873 4.14-4.14v4.639l-3.364 3.374Z" clip-rule="evenodd"/><path d="M9.318 18.345a.972.972 0 0 0-1.86-.561c-.482 1.435-1.687 2.204-2.934 2.619a8.22 8.22 0 0 1-1.23.302c.062-.365.157-.79.303-1.229.415-1.247 1.184-2.452 2.62-2.935a.971.971 0 1 0-.62-1.842c-.12.04-.236.084-.35.13-2.02.828-3.012 2.588-3.493 4.033a10.383 10.383 0 0 0-.51 2.845l-.001.016v.063c0 .536.434.972.97.972H2.24a7.21 7.21 0 0 0 .878-.065c.527-.063 1.248-.19 2.02-.447 1.445-.48 3.205-1.472 4.033-3.494a5.828 5.828 0 0 0 .147-.407Z"/>',
  caution:
    '<path d="M12 16a1 1 0 1 0 0 2 1 1 0 0 0 0-2Zm10.67 1.47-8.05-14a3 3 0 0 0-5.24 0l-8 14A3 3 0 0 0 3.94 22h16.12a3 3 0 0 0 2.61-4.53Zm-1.73 2a1 1 0 0 1-.88.51H3.94a1 1 0 0 1-.88-.51 1 1 0 0 1 0-1l8-14a1 1 0 0 1 1.78 0l8.05 14a1 1 0 0 1 .05 1.02v-.02ZM12 8a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0V9a1 1 0 0 0-1-1Z"/>',
  danger:
    '<path d="M12 7a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0V8a1 1 0 0 0-1-1Zm0 8a1 1 0 1 0 0 2 1 1 0 0 0 0-2Zm9.71-7.44-5.27-5.27a1.05 1.05 0 0 0-.71-.29H8.27a1.05 1.05 0 0 0-.71.29L2.29 7.56a1.05 1.05 0 0 0-.29.71v7.46c.004.265.107.518.29.71l5.27 5.27c.192.183.445.286.71.29h7.46a1.05 1.05 0 0 0 .71-.29l5.27-5.27a1.05 1.05 0 0 0 .29-.71V8.27a1.05 1.05 0 0 0-.29-.71ZM20 15.31 15.31 20H8.69L4 15.31V8.69L8.69 4h6.62L20 8.69v6.62Z"/>',
};

let { type = "note", title } = Astro.props;

if (!asideVariants.includes(type)) {
  throw new AstroError(
    "Invalid `type` prop passed to the `<Aside>` component.\n",
    `Received: ${JSON.stringify(type)}\n` +
      `Expected one of ${asideVariants.map((variant) => JSON.stringify(variant)).join(", ")}`,
  );
}

title ??= defaultTitles[type];
---

<aside
  aria-label={title}
  class:list={["not-prose starlight-aside", `starlight-aside--${type}`]}
>
  <p class="starlight-aside__title" aria-hidden="true">
    <svg
      class="starlight-aside__icon"
      viewBox="0 0 24 24"
      aria-hidden="true"
      set:html={icons[type]}
    />
    {title}
  </p>
  <div class="starlight-aside__content"><slot /></div>
</aside>

<style>
  .starlight-aside {
    color-scheme: light dark;
    margin-block: 1.5rem;
    padding: 1rem;
    border-inline-start: 0.25rem solid var(--aside-border);
    color: var(--foreground);
  }

  .starlight-aside--note {
    --aside-accent: light-dark(oklch(0.45 0.16 255), oklch(0.8 0.11 245));
    --aside-border: light-dark(oklch(0.62 0.2 255), oklch(0.65 0.18 250));
    background-color: light-dark(oklch(0.96 0.025 250), oklch(0.23 0.045 250));
  }

  .starlight-aside--tip {
    --aside-accent: light-dark(oklch(0.45 0.17 305), oklch(0.82 0.11 305));
    --aside-border: light-dark(oklch(0.6 0.2 305), oklch(0.67 0.18 305));
    background-color: light-dark(oklch(0.96 0.025 305), oklch(0.23 0.045 305));
  }

  .starlight-aside--caution {
    --aside-accent: light-dark(oklch(0.48 0.14 60), oklch(0.84 0.13 75));
    --aside-border: light-dark(oklch(0.68 0.17 65), oklch(0.73 0.15 70));
    background-color: light-dark(oklch(0.97 0.03 75), oklch(0.24 0.04 65));
  }

  .starlight-aside--danger {
    --aside-accent: light-dark(oklch(0.48 0.2 25), oklch(0.82 0.13 25));
    --aside-border: light-dark(oklch(0.62 0.23 25), oklch(0.68 0.2 25));
    background-color: light-dark(oklch(0.96 0.03 25), oklch(0.23 0.045 25));
  }

  .starlight-aside__title {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--aside-accent);
  }

  .starlight-aside__icon {
    width: 1.333em;
    height: 1.333em;
    fill: currentColor;
    flex: none;
  }

  .starlight-aside__title + .starlight-aside__content {
    margin-top: 0.5rem;
  }

  .starlight-aside__content:empty {
    display: none;
  }

  .starlight-aside__content :global(> :first-child) {
    margin-top: 0;
  }

  .starlight-aside__content :global(> :last-child) {
    margin-bottom: 0;
  }

  .starlight-aside__content :global(a) {
    color: var(--aside-accent);
  }
</style>
